{
  "name": "ronpicard-com",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://ronpicard.com/",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "mirror:resources": "node --experimental-strip-types scripts/mirror-resources.mjs",
    "mirror:readmes": "node --experimental-strip-types scripts/mirror-readmes.mjs",
    "optimize:resources": "node --experimental-strip-types scripts/optimize-resources.mjs",
    "generate:thumbs": "node --experimental-strip-types scripts/generate-thumbs.mjs",
    "generate:og": "node --experimental-strip-types scripts/generate-og-images.mjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-server",
    "build:full": "tsc --noEmit && node --experimental-strip-types scripts/mirror-resources.mjs && node --experimental-strip-types scripts/mirror-readmes.mjs && node --experimental-strip-types scripts/generate-thumbs.mjs && node --experimental-strip-types scripts/generate-og-images.mjs && vite build && npm run build:ssr && node --experimental-strip-types scripts/prerender.mjs"
  },
  "dependencies": {
    "isomorphic-dompurify": "^4.6.0",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "cheerio": "^1.2.0",
    "jsdom": "^30.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
